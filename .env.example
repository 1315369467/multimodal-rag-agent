# DashScope API Key (Qwen models)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model Configuration
LLM_MODEL=qwen3-235b-a22b
VL_MODEL=qwen-vl-max
EMBEDDING_MODEL=text-embedding-v3
RERANKER_MODEL=gte-rerank

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=multimodal_rag

# Document Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_WORKERS=4

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=10
FINAL_TOP_K=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
